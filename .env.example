# ──────────────────────────────────────────────────────────────
# PixVerse Environment Variables
# ──────────────────────────────────────────────────────────────
#
# HOW TO USE:
# 1. Copy this file:  cp .env.example .env
# 2. Go to https://console.firebase.google.com
# 3. Create a project (or open an existing one)
# 4. Go to Project Settings → General → Your apps → Web app
# 5. Copy the config values and paste them below
# 6. Enable Google sign-in: Authentication → Sign-in method → Google → Enable
# 7. Restart the dev server after editing .env
#
# ──────────────────────────────────────────────────────────────

# ── Firebase Configuration ────────────────────────────────────
# Paste your real Firebase config values here (without quotes is fine)

VITE_FIREBASE_API_KEY=PASTE_YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=PASTE_YOUR_AUTH_DOMAIN_HERE
VITE_FIREBASE_PROJECT_ID=PASTE_YOUR_PROJECT_ID_HERE
VITE_FIREBASE_STORAGE_BUCKET=PASTE_YOUR_STORAGE_BUCKET_HERE
VITE_FIREBASE_MESSAGING_SENDER_ID=PASTE_YOUR_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=PASTE_YOUR_APP_ID_HERE

# ── Unsplash API ──────────────────────────────────────────────
# Get a free access key at https://unsplash.com/developers

VITE_UNSPLASH_ACCESS_KEY=PASTE_YOUR_UNSPLASH_ACCESS_KEY_HERE
